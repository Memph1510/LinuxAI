[Unit]
Description=LinuxAI mind (the AI working behind the scenes)
# Not for root: an admin logging in on a console gets no LinuxAI services (and no unsandboxed browser).
ConditionUser=!root
ConditionPathExists=%h/.config/linuxai/env

[Service]
ExecStart=/usr/local/bin/cortex mind
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
