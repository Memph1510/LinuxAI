[Unit]
Description=LinuxAI core (the system's mind-body interface)
Documentation=https://github.com/memph1510/linuxai
After=local-fs.target dbus.service
Wants=dbus.service

[Service]
Type=notify
# Sending email (the send_email verb) happens in the core: LINUXAI_SMTP_* and LINUXAI_MAIL_FROM in mail.env.
EnvironmentFile=-/etc/linuxai/mail.env
# The AI's own account (linuxai-ai) can reach the socket but never speaks for the human: the core checks who connects.
Environment=LINUXAI_AI_USER=linuxai-ai
ExecStart=/usr/local/bin/linuxai-core daemon --group linuxai --socket-group linuxai-core --playbooks /home/linuxai/playbooks --prompts /home/linuxai/prompts
Restart=always
RestartSec=2
RuntimeDirectory=linuxai
RuntimeDirectoryMode=0755
StateDirectory=linuxai

[Install]
WantedBy=multi-user.target
